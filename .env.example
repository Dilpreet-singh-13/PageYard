
# CORE DJANGO SETTINGS
# Security key for cryptographic signing. Generate a strong key for production from https://djecrety.ir/
DJANGO_SECRET_KEY="django-insecure-your-secret-key-here"
# Set to True for local development, False for production
DEBUG=True
# Comma-separated list of host/domain names that this Django site can serve
# Example: localhost,127.0.0.1,www.your-domain.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of trusted origins for unsafe requests (e.g. POST)
# Required in production when SECURE_SSL_REDIRECT is enabled
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ==============================================================================
# DATABASE CONFIGURATION
# Standard database connection URL parsed by dj_database_url package
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pageyard_db


# ==============================================================================
# REDIS (Caching & Celery Result Backend)
# Required in production for session rate limits, view caching, and Celery task results.
# Example (Local): redis://127.0.0.1:6379/0
# Example (Upstash): rediss://default:your_password@your_endpoint.upstash.io:6379
# Similarly for any other provider
REDIS_URL=redis://127.0.0.1:6379/0


# ==============================================================================
# CELERY MESSAGE BROKER (RabbitMQ)
# AMQP connection URL for Celery task queuing.
# Example (Local Docker): amqp://guest:guest@localhost:5672//
# Example (CloudAMQP): amqps://user:password@hostname.rmq.cloudamqp.com/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672//


# ==============================================================================
# OBJECT STORAGE (S3-Compatible Storage: Cloudflare R2 / AWS S3 / MinIO)
# Note: Any S3-compatible service can be used without changing backend code.
# For Cloudflare R2:
#   - AWS_S3_ENDPOINT_URL = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#   - R2_PUBLIC_DOMAIN = pub-xxx.r2.dev or custom domain like media.your-domain.app
# For AWS S3:
#   - AWS_S3_ENDPOINT_URL = https://s3.<region>.amazonaws.com
#   - R2_PUBLIC_DOMAIN = <bucket-name>.s3.amazonaws.com

R2_ACCOUNT_ID=your_cloudflare_account_id
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=pub-abcdabcdabcd.r2.dev


# ==============================================================================
# GOOGLE OAUTH2 (django-allauth)
# Obtain credentials from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# ==============================================================================
# EMAIL CONFIGURATION (Resend SMTP Example)
# In DEBUG mode, email outputs to the terminal console regardless of these settings.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=PageYard Support <support@your-domain.app>